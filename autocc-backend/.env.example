PORT=
APP_TIMEZONE=
UPLOAD_TMP_DIR=
UPLOAD_MAX_FILE_SIZE_MB=

# mysql | postgres — default mysql (consolidaciones / entorno actual).
# Para Neon: DB_TYPE=postgres + DATABASE_URL (y DB_SYNCHRONIZE=false en prod para migraciones).
DB_TYPE=mysql

# Postgres (Neon / Render). Si está definida, tiene prioridad sobre DB_HOST para TypeORM.
DATABASE_URL=

# Desactiva SSL explícito del lado TypeORM (p. ej. Postgres en Docker local sin TLS).
# En Neon dejar sin definir o distinto de false.
DB_SSL=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNCHRONIZE=
DB_LOGGING=
DB_TIMEZONE=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=

# Optional: if set, every non-public API route requires this header:
# x-api-key: <API_KEY>
API_KEY=

# Role header expected on protected routes:
# x-user-role: admin | operator

# JWT auth
JWT_SECRET=
JWT_EXPIRES_IN=

# First run:
# 1) POST /api/auth/bootstrap-admin  (public, only works if users table is empty)
# 2) POST /api/auth/login
# 3) Send Authorization: Bearer <token> on protected routes