PORT=3000
APP_TIMEZONE=UTC
UPLOAD_TMP_DIR=tmp/uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# mysql | postgres
DB_TYPE=mysql

# MySQL local (desarrollo diario)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auto_cc
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_TIMEZONE=Z

# Si DB_TYPE=postgres y usas URL en local, puede ir acá.
DATABASE_URL=
DB_SSL=false

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
API_KEY=
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=8h
