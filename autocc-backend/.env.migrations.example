# Archivo exclusivo para comandos de migraciones.
# Recomendado: apuntar a Postgres/Neon (branch staging/baseline o production según etapa).

DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DB_SSL=true

# En migraciones, siempre false.
DB_SYNCHRONIZE=false
DB_LOGGING=false
